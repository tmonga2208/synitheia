# React Native's toolchain (Metro, the Babel runtime, autolinking) assumes an
# npm-style hoisted node_modules and resolves many peers implicitly. pnpm's strict
# symlinked layout breaks that one package at a time — @expo/metro-runtime, then
# @babel/runtime, then the next. Hoisting is the supported configuration for RN
# monorepos and avoids chasing each missing peer individually.
node-linker=hoisted
