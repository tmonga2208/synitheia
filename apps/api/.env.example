NODE_ENV=development
PORT=4000
LOG_LEVEL=info

MONGO_URI=mongodb://localhost:27017/synitheia?replicaSet=rs0&directConnection=true

# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Social sign-in (optional in dev)
APPLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=

# Synthesia AI. The app is fully functional without a key — every AI path is gated on
# both a key AND the user's explicit consent.
#
# Set ONE of the keys below. If both are present, pick with AI_PROVIDER.
# The provider is a deployment choice; no domain code knows which model answered.
# AI_PROVIDER=gemini

# Google AI Studio -> https://aistudio.google.com/apikey  (has a free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

CORS_ORIGINS=*

# UPI Lens API — external statement parser for bank statements (PDF text, CSV, XLS, XLSX)
# Optional: defaults to the hosted service at https://upi-lens-api.vercel.app
UPI_LENS_API_URL=https://upi-lens-api.vercel.app
# The same value as UPI_LENS_API_KEY on the upi-lens deployments (openssl rand -hex 32).
UPI_LENS_API_KEY=

# ImageKit — receipt image storage. Optional: without it, receipts are simply unavailable
# and the rest of the app is unaffected. Only the file id and path are stored in Mongo;
# images are uploaded as PRIVATE files and served through short-lived signed URLs.
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
